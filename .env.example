# 재무탐정 — 로컬 서버 설정
# 실제 값은 .env에만 입력하세요. 이 예시 파일에는 인증키를 넣지 않습니다.
# 키를 React/VITE_* 환경변수에 넣지 마세요. 백엔드에서만 사용합니다.
# 지금 입력할 항목: DART_API_KEY, SEC_USER_AGENT. AI 설명 질문에는 OpenAI 항목도 필요합니다.

# [한국 공시 · OpenDART]
# providers 모듈에서 사용합니다. 발급받은 40자리 인증키를 입력하세요.
# 신청: https://opendart.fss.or.kr/uss/umt/EgovMberInsertView.do
DART_API_KEY=

# [미국 공시 · SEC]
# API 키는 필요하지 않습니다. 앱 이름과 실제 연락 가능한 이메일을 입력하세요.
# 입력 형식: SEC_USER_AGENT="FinanceDetective your-email@example.com"
SEC_USER_AGENT=

# [OpenAI · 공시 근거 답변 생성]
# 공식 안내: https://developers.openai.com/api/docs/quickstart
# OpenAI API 인증키. 모델 API를 호출할 때 별도 비용이 발생할 수 있습니다.
OPENAI_API_KEY=
# 답변 생성 모델. 비어 있으면 gpt-4.1-mini를 사용합니다.
# OPENAI_MODEL은 프로젝트 설정명입니다. 현재 RAG에서 사용합니다.
OPENAI_MODEL=gpt-4.1-mini
# 생성 답변과 원문의 의미를 대조하는 별도 검토 모델
OPENAI_REVIEW_MODEL=gpt-4.1

# [OpenAI · 공시 임베딩 검색]
# 문서를 벡터로 변환할 모델. text-embedding-3 계열의 512차원을 사용합니다.
# 비어 있으면 text-embedding-3-small을 사용합니다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# [설정 로드 범위]
# 새 providers 모듈은 프로젝트 루트 .env를 읽으며, 서버 환경변수가 우선합니다.
# 기존 Coupang 전용 collectors/sec.py는 서버 환경변수만 읽습니다.
# 설명 질문에서만 AI를 호출하며, 단순 수치 조회는 LLM을 호출하지 않습니다.
# [PostgreSQL + pgvector]
# .venv/bin/python scripts/setup_local.py 가 비밀번호와 접속 주소를 안전하게 채웁니다.
# docker compose up -d --wait 로 DB 실행. 기존 API 키는 유지됩니다.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=

# [AI 접근과 비용 제어]
# local: 이 컴퓨터에서만 단일 개발자 계정. 외부 배포에서는 반드시 token 사용.
# token: scripts/create_access_token.py --user 사용자명 으로 발급한 이용 코드 필요.
# 외부 배포는 HTTPS, reverse proxy 설정, DB 권한 분리도 별도로 구성하세요.
AI_AUTH_MODE=local
# USD, UTC 기준. 0은 유료 호출 중단. 예약된/불확실한 비용도 한도에 포함.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=30
AI_USER_DAILY_BUDGET_USD=1
AI_USER_DAILY_REQUESTS=50
AI_REQUEST_BUDGET_USD=0.15
AI_MAX_CONCURRENT_REQUESTS=4
# 입력을 UTF-8 바이트 상한 + 프레이밍 여유분으로 보수적으로 제한.
AI_MAX_INPUT_TOKENS=64000
AI_CACHE_TTL_SECONDS=86400

# [Agent · LangChain + LangGraph]
# 기존 모델 요금표에 등록된 모델만 사용합니다. 모든 계획 호출도 예산에 포함합니다.
OPENAI_AGENT_MODEL=gpt-4.1-mini
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=120

# [Property Graph · Neo4j]
# setup_local.py가 안전한 비밀번호를 생성합니다. 공개 주소에 기본 포트를 노출하지 않습니다.
NEO4J_PASSWORD=
NEO4J_USERNAME=neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
