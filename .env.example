# 재무탐정 — 로컬 서버 설정
# 실제 값은 .env에만 입력하세요. 이 예시 파일에는 인증키를 넣지 않습니다.
# 키를 React/VITE_* 환경변수에 넣지 마세요. 백엔드에서만 사용합니다.
# 지금 입력할 항목: DART_API_KEY, SEC_USER_AGENT. AI 설명 질문에는 OpenAI 항목도 필요합니다.

# [한국 공시 · OpenDART]
# providers 모듈에서 사용합니다. 발급받은 40자리 인증키를 입력하세요.
# 신청: https://opendart.fss.or.kr/uss/umt/EgovMberInsertView.do
DART_API_KEY=

# [미국 공시 · SEC]
# API 키는 필요하지 않습니다. 앱 이름과 실제 연락 가능한 이메일을 입력하세요.
# 입력 형식: SEC_USER_AGENT="FinanceDetective your-email@example.com"
SEC_USER_AGENT=

# [OpenAI · 공시 근거 답변 생성]
# 공식 안내: https://developers.openai.com/api/docs/quickstart
# OpenAI API 인증키. 모델 API를 호출할 때 별도 비용이 발생할 수 있습니다.
OPENAI_API_KEY=
# 답변 생성 모델. 비어 있으면 gpt-4.1-mini를 사용합니다.
# OPENAI_MODEL은 프로젝트 설정명입니다. 현재 RAG에서 사용합니다.
OPENAI_MODEL=gpt-4.1-mini
# 생성 답변과 원문의 의미를 대조하는 별도 검토 모델
OPENAI_REVIEW_MODEL=gpt-4.1

# [OpenAI · 공시 임베딩 검색]
# 문서를 벡터로 변환할 모델. text-embedding-3 계열의 512차원을 사용합니다.
# 비어 있으면 text-embedding-3-small을 사용합니다.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# [설정 로드 범위]
# 새 providers 모듈은 프로젝트 루트 .env를 읽으며, 서버 환경변수가 우선합니다.
# 기존 Coupang 전용 collectors/sec.py는 서버 환경변수만 읽습니다.
# 설명 질문에서만 AI를 호출하며, 단순 수치 조회는 LLM을 호출하지 않습니다.
# SQLite는 data/processed/rag.sqlite3에 저장하며 별도 DB 키가 필요하지 않습니다.
